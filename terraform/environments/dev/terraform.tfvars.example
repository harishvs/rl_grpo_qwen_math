# Dev Environment - Terraform Variables
# Copy this file to terraform.tfvars and update with your values:
#   cp terraform.tfvars.example terraform.tfvars

aws_region   = "us-east-1"
project_name = "rl-code-llm-training"
environment  = "dev"

vpc_cidr           = "10.0.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b", "us-east-1c"]

kubernetes_version = "1.29"

# GPU Node Group
gpu_instance_types = ["p4d.24xlarge"]
gpu_desired_size   = 2
gpu_min_size       = 0
gpu_max_size       = 2

# EFA for cross-node NCCL (400 Gbps RDMA)
efa_enabled             = true
capacity_reservation_id = ""                # Your AWS capacity reservation ID (if using capacity blocks)
gpu_subnet_ids          = []                # Pin to specific subnet for capacity blocks, e.g. ["subnet-0abc123"]

# CPU Node Group (for reward actor, monitoring)
cpu_instance_types = ["c7i.large"]
cpu_desired_size   = 2
cpu_min_size       = 1
cpu_max_size       = 10
